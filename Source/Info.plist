<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Screenshot Buddy</string>
	<key>CFBundleExecutable</key>
	<string>ScreenshotBuddy</string>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>CFBundleIdentifier</key>
	<string>com.hugh.screenshotbuddy</string>
	<key>CFBundleName</key>
	<string>ScreenshotBuddy</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- Fed from project.yml (MARKETING_VERSION / CURRENT_PROJECT_VERSION) so the build
	     number has exactly one source of truth. These were previously hardcoded, which meant
	     bumping project.yml silently shipped the old number and App Store Connect would
	     reject the upload as a duplicate. -->
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<!-- Export compliance, declared here so App Store Connect stops flagging every build as
	     "Missing Compliance" and asking the encryption question at submission time.
	     `false` is accurate and was verified before it was set: the app links no Security,
	     CommonCrypto, or Network frameworks, uses no crypto APIs, and makes no network
	     connections of any kind. It only reads image files from one local folder.
	     If networking is ever added (even plain HTTPS), revisit this: HTTPS alone still counts
	     as encryption, though it normally qualifies for the exempt category rather than false. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSDesktopFolderUsageDescription</key>
	<string>Screenshot Buddy needs access to your screenshots folder to show and manage your screenshots.</string>
	<key>NSDocumentsFolderUsageDescription</key>
	<string>Screenshot Buddy needs access to your screenshots folder to show and manage your screenshots.</string>
	<key>NSDownloadsFolderUsageDescription</key>
	<string>Screenshot Buddy needs access to your screenshots folder to show and manage your screenshots.</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>© 2026 Hugh Southall. All rights reserved.</string>
</dict>
</plist>
